# Dependencias y salidas de build, en cualquier paquete del monorepo
node_modules/
dist/
.astro/
.next/
out/

# Caché incremental de TypeScript. Estaba versionada y aparecía modificada en
# cada `git status` después de cualquier typecheck, o sea ruido en todos los
# diffs por un fichero que solo vale en la máquina que lo generó.
*.tsbuildinfo

# Proveedores
.netlify/
.vercel/
.supabase/

# Secretos. Ninguna clave entra al repositorio: van en variables de entorno.
.env
.env.*
!.env.example

# Sistema y registros
.DS_Store
Thumbs.db
*.log
npm-debug.log*
