# Dependencias y salidas de build, en cualquier paquete del monorepo
node_modules/
dist/
.astro/
.next/
out/

# Caché incremental de TypeScript. Estaba versionada y aparecía modificada en
# cada `git status` después de cualquier typecheck, o sea ruido en todos los
# diffs por un fichero que solo vale en la máquina que lo generó.
*.tsbuildinfo

# Proveedores
.netlify/
.vercel/
.supabase/

# Secretos. Ninguna clave entra al repositorio: van en variables de entorno.
.env
.env.*
!.env.example

# Carpeta de credenciales de trabajo. Se ignora entera y por dos vías —el
# directorio y cualquier cosa dentro— porque una sola regla mal escrita aquí
# publica las llaves de todos los tenants.
secrets/
secrets/**

# Salidas de los scripts de captura y grabación. Son ARTEFACTOS: se regeneran
# con `grabar-screencasts.mjs` y `capturar.mjs` en un minuto, y pesan megas.
#
# Entraron al repositorio el 6 de agosto de 2026 por un `git add -A` descuidado
# mientras se grababan los vídeos del App Review. Se sacaron con
# `git rm -r --cached`, así que siguen en el historial: no se reescribió nada
# publicado por diez megas, pero que no crezca.
screencasts/
capturas/

# Sistema y registros
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Caché del CLI de Supabase. Cambia en cada invocación y no vale nada fuera
# de la máquina que lo generó.
supabase/.temp/
