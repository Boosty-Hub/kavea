---
import Logo from './Logo.astro'
---

<header class="hdr">
  <div class="page hdr__inner">
    <a href="/" class="hdr__brand" aria-label="Kavea — inicio">
      <Logo size={26} />
    </a>

    <nav class="hdr__nav" aria-label="Principal">
      <a href="/#que-es">Qué es</a>
      <a href="/#canales">Canales</a>
      <a href="/#nombre">El nombre</a>
      <a href="/privacidad">Privacidad</a>
      {/* Último y destacado. Y con `hdr__entrar` para que NO lo esconda la regla
          de móvil de abajo: en el móvil se ocultan los enlaces de navegación
          porque no caben, y esconder justo la puerta de entrada sería el peor
          candidato posible. */}
      <a href="/entrar" class="hdr__entrar">Entrar</a>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--k-bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--k-border);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    min-height: 64px;
  }

  .hdr__brand {
    text-decoration: none;
    flex: none;
  }

  .hdr__nav {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    font-size: 14px;
  }

  .hdr__nav a {
    color: var(--k-text-2);
    text-decoration: none;
    white-space: nowrap;
  }

  .hdr__nav a:hover {
    color: var(--k-text);
  }

  .hdr__nav a.hdr__entrar {
    color: var(--k-text);
    border: 1px solid var(--k-border);
    border-radius: 999px;
    padding: 6px 14px;
    background: var(--k-surface);
  }

  .hdr__nav a.hdr__entrar:hover {
    border-color: var(--k-acento);
    color: var(--k-acento);
  }

  @media (max-width: 720px) {
    /* Se esconden los de navegación, no el de entrar. La regla anterior era
       `:not(:last-child)`, que dependía del ORDEN: al añadir «Entrar» al final
       habría escondido «Privacidad» y dejado el nuevo, por accidente y no por
       decisión. Ahora se nombra lo que se esconde. */
    .hdr__nav a:not(.hdr__entrar) {
      display: none;
    }
  }
</style>
