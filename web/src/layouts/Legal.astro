---
import Base from './Base.astro'
import { legal } from '../data/legal'

interface Props {
  title: string
  description: string
  path: string
  /** Resumen en una línea que va bajo el título. */
  intro: string
  /** Índice de la página: pares de ancla y etiqueta. */
  indice: { id: string; label: string }[]
}

const { title, description, path, intro, indice } = Astro.props
---

<Base title={title} description={description} path={path}>
  <div class="page">
    <article class="doc">
      <header class="doc__head">
        <p class="label">Documento legal</p>
        <h1>{title}</h1>
        <p class="lead">{intro}</p>
        <p class="doc__meta">
          En vigor desde el {legal.vigenciaDesde}
          <span aria-hidden="true">·</span>
          Titular: {legal.razonSocial}
        </p>
      </header>

      <nav class="toc" aria-label="Contenido del documento">
        <p class="label">En esta página</p>
        <ol>
          {indice.map((s) => (
            <li><a href={`#${s.id}`}>{s.label}</a></li>
          ))}
        </ol>
      </nav>

      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</Base>

<style>
  .doc {
    padding-block: var(--s-16) var(--s-8);
  }

  .doc__head {
    max-width: var(--k-measure);
    margin-bottom: var(--s-10);
  }

  .doc__head h1 {
    margin-block: var(--s-3) var(--s-4);
  }

  .doc__meta {
    margin: var(--s-5) 0 0;
    font-size: 13px;
    color: var(--k-text-3);
  }

  .doc__meta span {
    padding-inline: var(--s-1);
  }

  .toc {
    max-width: var(--k-measure);
  }
</style>
