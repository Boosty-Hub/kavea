# Copiar a app/.env.local para desarrollo. NUNCA se versiona con valores reales.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://sdazqohyjzzylwbkvovx.supabase.co

# Clave publicable. Puede ir al navegador: toda lectura pasa por RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave de servicio. SALTA RLS. Solo en variables de entorno del servidor.
# En Netlify va únicamente en el contexto `production`: un Deploy Preview lo
# puede abrir cualquiera con acceso al repositorio, y con esta clave leería
# cualquier fila de cualquier tenant.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Enrutado ---
# En local: localhost. En producción: kavea.ai.
# Es variable y no constante para que, si los tenants acaban en app.kavea.ai,
# no haya que tocar el middleware.
NEXT_PUBLIC_DOMINIO_RAIZ=localhost

# --- Meta (fase 1 en adelante, todavía sin uso) ---
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
GRAPH_API_VERSION=v26.0

# --- Netlify Blobs, amortiguador de la ingesta (fase 1) ---
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# --- Correo ---
RESEND_API_KEY=
